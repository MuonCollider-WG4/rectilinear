physics QGSP_BERT_EMX doStochastics=0 disable=Decay list=1

param snake=0
param mode=3
param physical=1
param coilname1=coil1
param coilname2=coil2
param coilname3=coil3
param coilname4=coil4
param cell_length=630
param solpos1=0.10030375475682805
param coil_length1=74.98707438741039
param coil_radius1=25
param coil_width1=50
param current1=326.7503651228888
param solpos2=0.0877899605342023
param coil_length2=89.17248104545402
param coil_radius2=85
param coil_width2=100
param current2=146.14050614368728
param solpos3=0.29815411600718544
param coil_length3=167.8694285891552
param coil_radius3=195
param coil_width3=105
param current3=207.8362403858834
param solpos4=0.14229686651276985
param coil_length4=133.37369827581156
param coil_radius4=310
param coil_width4=200
param current4=117.12098012978761
param angle=1.5
param bendpos=0.1
param dipole=0.155
param dipole_length=100
param pipe_radius=45
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius #$dipole_length/10

genericbend solbend1 fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1

genericbend solbend2 fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=-$dipole kill=1 fringe=0 ironColor=1,1,1



if $mode==1
coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=($coil_radius1+4*$coil_width1) #tolerance=0.02
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 
endif

if $mode==2
coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=($coil_radius1+4*$coil_width1) #tolerance=0.02
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=($coil_radius2+4*$coil_width2) #tolerance=0.02
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 
endif

if $mode==3
coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=$coil_radius1+4*$coil_width1 #tolerance=0.01
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=$coil_radius2+4*$coil_width2 #tolerance=0.01
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 

coil $coilname3 innerRadius=$coil_radius3 outerRadius=$coil_radius3+$coil_width3 length=$coil_length3 material=Cu maxZ=$cell_length maxR=$coil_radius3+4*$coil_width3 #tolerance=0.01
solenoid sol5 coilName=$coilname3 current=$current3 kill=1 
solenoid sol6 coilName=$coilname3 current=-$current3 kill=1 
endif

if $mode==4
coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=$coil_radius1+4*$coil_width1 #tolerance=0.01
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=$coil_radius2+4*$coil_width2 #tolerance=0.01
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 

coil $coilname3 innerRadius=$coil_radius3 outerRadius=$coil_radius3+$coil_width3 length=$coil_length3 material=Cu maxZ=$cell_length maxR=$coil_radius3+4*$coil_width3 #tolerance=0.01
solenoid sol5 coilName=$coilname3 current=$current3 kill=1 
solenoid sol6 coilName=$coilname3 current=-$current3 kill=1 

coil $coilname4 innerRadius=$coil_radius4 outerRadius=$coil_radius4+$coil_width4 length=$coil_length4 material=Cu maxZ=$cell_length maxR=$coil_radius4+4*$coil_width4 #tolerance=0.01
solenoid sol7 coilName=$coilname4 current=$current4 kill=1 
solenoid sol8 coilName=$coilname4 current=-$current4 kill=1 
endif

#tubs pipe innerRadius=180 outerRadius=190 length=$cell_length kill=1

if $physical==0
if $snake==0
fieldexpr fringe_left1 length=2*$fringe_length width=1000 height=1000 By=if(z<0,0,$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_right1 length=2*$fringe_length width=1000 height=1000 By=if(z>=0,0,$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_left2 length=2*$fringe_length width=1000 height=1000 By=if(z<0,0,-$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_right2 length=2*$fringe_length width=1000 height=1000 By=if(z>=0,0,-$dipole/($fringe_length)^2*z^2)
endif

if $snake==1
fieldexpr fringe_left1 length=2*$fringe_length width=1000 height=1000 Bx=if(z<0,0,$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_right1 length=2*$fringe_length width=1000 height=1000 Bx=if(z>=0,0,$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_left2 length=2*$fringe_length width=1000 height=1000 Bx=if(z<0,0,-$dipole/($fringe_length)^2*z^2)
fieldexpr fringe_right2 length=2*$fringe_length width=1000 height=1000 Bx=if(z>=0,0,-$dipole/($fringe_length)^2*z^2)
endif
endif

if $physical==1
fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(3.5*-z/$pipe_diameter)*cos(3.5*y/$pipe_diameter))/(1+2*exp(3.5*-z/$pipe_diameter)*cos(3.5*y/$pipe_diameter)+exp(2*3.5*-z/$pipe_diameter))) Bz=-$dipole*exp(3.5*-z/$pipe_diameter)*sin(3.5*y/$pipe_diameter)/(1+2*exp(3.5*-z/$pipe_diameter)*cos(3.5*y/$pipe_diameter)+exp(2*3.5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 #tolerance=0.5
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(3.5*z/$pipe_diameter)*cos(3.5*y/$pipe_diameter))/(1+2*exp(3.5*z/$pipe_diameter)*cos(3.5*y/$pipe_diameter)+exp(2*3.5*z/$pipe_diameter))) Bz=-$dipole*exp(3.5*z/$pipe_diameter)*sin(3.5*y/$pipe_diameter)/(1+2*exp(3.5*z/$pipe_diameter)*cos(3.5*y/$pipe_diameter)+exp(2*3.5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 #tolerance=0.5
endif

if $snake==1
if $mode==1
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length/2 
place sol2 z=$i*$cell_length+$cell_length/2-$solpos1*$cell_length/2 
place sol2 z=$i*$cell_length+$cell_length/2+$solpos1*$cell_length/2 
place sol1 z=$i*$cell_length+$cell_length-$solpos1*$cell_length/2 
enddo
endif

if $mode==2
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length/2 
place sol3 z=$i*$cell_length+$solpos2*$cell_length/2 
place sol4 z=$i*$cell_length+$cell_length/2-$solpos2*$cell_length/2 
place sol2 z=$i*$cell_length+$cell_length/2-$solpos1*$cell_length/2 
place sol2 z=$i*$cell_length+$cell_length/2+$solpos1*$cell_length/2 
place sol4 z=$i*$cell_length+$cell_length/2+$solpos2*$cell_length/2 
place sol3 z=$i*$cell_length+$cell_length-$solpos2*$cell_length/2 
place sol1 z=$i*$cell_length+$cell_length-$solpos1*$cell_length/2 
enddo
endif
endif

if $snake==0
if $mode==1
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length
place sol2 z=$i*$cell_length+$cell_length-$solpos1*$cell_length
enddo
endif

if $mode==2
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length
place sol3 z=$i*$cell_length+$solpos2*$cell_length 
place sol4 z=$i*$cell_length+$cell_length-$solpos2*$cell_length 
place sol2 z=$i*$cell_length+$cell_length-$solpos1*$cell_length
enddo
endif

if $mode==3
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length
place sol3 z=$i*$cell_length+$solpos2*$cell_length 
place sol5 z=$i*$cell_length+$solpos3*$cell_length 
place sol6 z=$i*$cell_length+$cell_length-$solpos3*$cell_length 
place sol4 z=$i*$cell_length+$cell_length-$solpos2*$cell_length 
place sol2 z=$i*$cell_length+$cell_length-$solpos1*$cell_length
enddo
endif

if $mode==4
do i -2 4
place sol1 z=$i*$cell_length+$solpos1*$cell_length
place sol3 z=$i*$cell_length+$solpos2*$cell_length 
place sol5 z=$i*$cell_length+$solpos3*$cell_length 
place sol7 z=$i*$cell_length+$solpos4*$cell_length 
place sol8 z=$i*$cell_length-$solpos4*$cell_length 
place sol6 z=$i*$cell_length+$cell_length-$solpos3*$cell_length 
place sol4 z=$i*$cell_length+$cell_length-$solpos2*$cell_length 
place sol2 z=$i*$cell_length+$cell_length-$solpos1*$cell_length
enddo
endif

endif

if $snake==1
do i -2 4
place solbend1 z=$i*$cell_length+$bendpos*$cell_length/2 
place solbend2 z=$i*$cell_length+$cell_length/2-$bendpos*$cell_length/2
place solbend2 z=$i*$cell_length+$cell_length/2+$bendpos*$cell_length/2 
place solbend1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length/2 
enddo

if $physical==0
do i -2 4
place fringe_left1 z=$i*$cell_length+$bendpos*$cell_length/2-$dipole_length/2-$fringe_length
place fringe_right1 z=$i*$cell_length+$bendpos*$cell_length/2+$dipole_length/2+$fringe_length+0.01
place fringe_left2 z=$i*$cell_length+$cell_length/2-$bendpos*$cell_length/2-$dipole_length/2-$fringe_length
place fringe_right2 z=$i*$cell_length+$cell_length/2-$bendpos*$cell_length/2+$dipole_length/2+$fringe_length+0.01
place fringe_left2 z=$i*$cell_length+$cell_length/2+$bendpos*$cell_length/2-$dipole_length/2-$fringe_length
place fringe_right2 z=$i*$cell_length+$cell_length/2+$bendpos*$cell_length/2+$dipole_length/2+$fringe_length+0.01
place fringe_left1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length/2-$dipole_length/2-$fringe_length
place fringe_right1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length/2+$dipole_length/2+$fringe_length+0.01
enddo
endif
endif

if $snake==0
do i -2 4
place solbend1 z=$i*$cell_length+$bendpos*$cell_length
place solbend1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length
enddo

if $physical==0
do i -2 4
place fringe_left1 z=$i*$cell_length+$bendpos*$cell_length-$dipole_length/2-$fringe_length
place fringe_right1 z=$i*$cell_length+$bendpos*$cell_length+$dipole_length/2+$fringe_length+0.01
place fringe_left1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length-$dipole_length/2-$fringe_length
place fringe_right1 z=$i*$cell_length+$cell_length-$bendpos*$cell_length+$dipole_length/2+$fringe_length+0.01
enddo
endif

if $physical==1
do i -2 4
place fringe_left z=$i*$cell_length+$bendpos*$cell_length-$dipole_length/2-$fringe_length/2
place fringe_right z=$i*$cell_length+$bendpos*$cell_length+$dipole_length/2+$fringe_length/2+0.01
place fringe_left z=$i*$cell_length+$cell_length-$bendpos*$cell_length-$dipole_length/2-$fringe_length/2
place fringe_right z=$i*$cell_length+$cell_length-$bendpos*$cell_length+$dipole_length/2+$fringe_length/2+0.01
enddo
endif
endif


#do i 0 2
#place pipe z=$i*$cell_length+$cell_length/2
#enddo

#printfield type=grid file=field_cell.dat field=Bx,By,Bz X0=-180 Y0=-180 Z0=$cell_length nX=61 dX=6 nY=61 dY=6 nZ=201 dZ=$cell_length/200

beam ascii file=beam.dat

trackcuts killSecondaries=1
zntuple z=2*$cell_length filename=final
trace nTrace=1